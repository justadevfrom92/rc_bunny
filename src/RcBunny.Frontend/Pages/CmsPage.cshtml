@page "/{**path}"
@model CmsPageModel
@inject Brand B
@{
    var p = Model.Content.Page;
    ViewData["Title"] = p.HtmlTitle ?? $"{p.Title} | {B.Name}";
    ViewData["Description"] = p.MetaDescription;
    var z = Model.Content.Zones;
    IEnumerable<string> Zone(string k) => z.TryGetValue(k, out var l) ? l : [];
}
@section Head {
    @if (p.NoIndex) { <meta name="robots" content="noindex"> }
    @if (p.HeadContent is { } head) { @Html.Raw(head) }
}
<section class="page-banner"><div class="wrap"><h1>@(p.PageTitle ?? p.Title)</h1></div></section>
@foreach (var html in Zone("top")) { <section class="section cms-zone"><div class="wrap">@Html.Raw(html)</div></section> }
<section class="section">
    <div class="wrap @(Zone("sidebar").Any() ? "split cms-with-sidebar" : "")">
        <article class="cms-content">
            @if (Model.Content.Parent is { } parent) { @Html.Raw(parent) }
            @if (Model.Content.Primary is { } primary) { @Html.Raw(primary) }
            @if (Model.Content.Secondary is { } secondary) { @Html.Raw(secondary) }
            @foreach (var html in Zone("main")) { @Html.Raw(html) }
            @if (Model.Content.Auxiliary is { } aux) { @Html.Raw(aux) }
        </article>
        @if (Zone("sidebar").Any())
        {
            <aside class="cms-sidebar">@foreach (var html in Zone("sidebar")) { @Html.Raw(html) }</aside>
        }
    </div>
</section>
@foreach (var html in Zone("bottom")) { <section class="section cms-zone"><div class="wrap">@Html.Raw(html)</div></section> }
