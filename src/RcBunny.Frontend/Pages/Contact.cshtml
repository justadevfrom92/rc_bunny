@page "/contact"
@model ContactModel
@{ ViewData["Title"] = $"Contact Us | {Site.Name}"; }
<section class="section">
    <div class="wrap contact-grid">
        <div>
            <div class="contact-card"><h3>Customer Care</h3><p><a href="@Site.PhoneLink">@Site.Phone</a><br>Mon–Fri 8am–6pm</p></div>
            <div class="contact-card"><h3>Power Outage?</h3><p>Call your local utility. They own the poles and wires and handle repairs.</p></div>
            <div class="contact-card"><h3>Manage Your Account</h3><p>See and pay your bill in <a href="/myaccount">My Account</a>.</p></div>
        </div>
        <form class="byop-panel" method="post">
            <h2>Send us a message</h2>
            @if (Model.Sent)
            {
                <div class="form-msg ok">Thanks! We got your message and will be in touch soon.</div>
            }
            else
            {
                <div asp-validation-summary="All" class="form-msg error"></div>
                <div class="form-2">
                    <div class="field"><label asp-for="Input.Name">Name *</label><input asp-for="Input.Name"></div>
                    <div class="field"><label asp-for="Input.Email">Email *</label><input asp-for="Input.Email" type="email"></div>
                </div>
                <div class="field"><label asp-for="Input.Phone">Phone</label><input asp-for="Input.Phone"></div>
                <div class="field">
                    <label asp-for="Input.Topic">Topic</label>
                    <select asp-for="Input.Topic" asp-items="@(new SelectList(ContactModel.Topics))"></select>
                </div>
                <div class="field"><label asp-for="Input.Message">Message *</label><textarea asp-for="Input.Message" rows="5"></textarea></div>
                <button class="btn" style="margin-top:12px">Send</button>
            }
        </form>
    </div>
</section>
