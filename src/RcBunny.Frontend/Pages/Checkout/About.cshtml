@page "/checkout/about"
@model AboutModel
@inject Brand B
@{ ViewData["Title"] = $"About You | {B.Name}"; var f = Model.Form; }
<section class="section section-sky"><div class="wrap" style="max-width:820px">
    <partial name="_Steps" model="@("about")" />
    <form method="post" class="byop-panel">
        <h1 style="font-size:1.6rem">About you</h1>
        @if (Model.Data.Biz) { <div class="field"><label for="bn">Business name</label><input id="bn" name="Form.BusinessName" value="@f.BusinessName"><span class="form-msg error">@Model.Err("Form.BusinessName")</span></div> }
        <div class="form-2" style="margin-top:16px">
            <div class="field"><label for="fn">First name</label><input id="fn" name="Form.FirstName" value="@f.FirstName" required autocomplete="given-name"><span class="form-msg error">@Model.Err("Form.FirstName")</span></div>
            <div class="field"><label for="ln">Last name</label><input id="ln" name="Form.LastName" value="@f.LastName" required autocomplete="family-name"><span class="form-msg error">@Model.Err("Form.LastName")</span></div>
        </div>
        <div class="form-2" style="margin-top:16px">
            <div class="field"><label for="em">Email</label><input id="em" type="email" name="Form.Email" value="@f.Email" required autocomplete="email"><span class="form-msg error">@Model.Err("Form.Email")</span></div>
            <div class="field"><label for="ph">Phone</label><input id="ph" type="tel" name="Form.Phone" value="@f.Phone" required autocomplete="tel"><span class="form-msg error">@Model.Err("Form.Phone")</span></div>
        </div>
        <div class="form-2" style="margin-top:16px">
            <div class="field"><label for="pt">Phone type</label><select id="pt" name="Form.PhoneType">@foreach (var t in new[] { "mobile", "landline", "voip" }) { <option selected="@(f.PhoneType == t)">@t</option> }</select></div>
            <div class="field"><label for="lg">Language</label><select id="lg" name="Form.Language">@foreach (var l in new[] { "English", "Spanish" }) { <option selected="@(f.Language == l)">@l</option> }</select></div>
        </div>
        <div class="field" style="margin-top:16px"><label for="ssn">Last 4 of your SSN (for the credit check)</label><input id="ssn" name="Form.SsnLast4" inputmode="numeric" maxlength="4" required autocomplete="off"><span class="form-msg error">@Model.Err("Form.SsnLast4")</span></div>
        <label class="opt-line" style="margin-top:12px"><input type="checkbox" name="Form.CreditFrozen" value="true"> My credit is frozen</label>
        <label class="opt-line"><input type="checkbox" name="Form.MarketingOptIn" value="true" checked="@f.MarketingOptIn"> Send me offers and news</label>
        <h2 style="font-size:1.1rem;margin-top:20px">Create your My Account login (optional)</h2>
        <div class="form-2">
            <div class="field"><label for="un">Username</label><input id="un" name="Form.Username" value="@f.Username" autocomplete="username"><span class="form-msg error">@Model.Err("Form.Username")</span></div>
            <div class="field"><label for="pw">Password</label><input id="pw" type="password" name="Form.Password" autocomplete="new-password"><span class="form-msg error">@Model.Err("Form.Password")</span></div>
        </div>
        <div class="field" style="margin-top:12px"><label for="pw2">Confirm password</label><input id="pw2" type="password" name="Form.PasswordConfirm" autocomplete="new-password"><span class="form-msg error">@Model.Err("Form.PasswordConfirm")</span></div>
        <button class="btn" style="margin-top:20px">Review My Order</button>
        <p><a href="/checkout/plan">← Back</a></p>
    </form>
</div></section>
