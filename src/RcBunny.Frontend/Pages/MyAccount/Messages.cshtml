@page "/myaccount/messages/{id:int?}"
@model MessagesModel
@inject Brand B
@{ ViewData["Title"] = $"Messages | {B.Name}"; }
<section class="section section-sky"><div class="wrap">
    <partial name="_Frame" model="Model" />
    <div class="ma-grid">
        <div class="byop-panel">
            <h2>Messages</h2>
            @if (Model.Messages.Count == 0) { <p>Nothing yet.</p> }
            <ul class="msg-list">
            @foreach (var m in Model.Messages)
            {
                <li class="@(m.OpenedAt == null ? "unread" : "")"><a href="/myaccount/messages/@m.Id">@(m.Template is { Length: > 0 } tn ? tn : m.Channel)</a> <small>@m.Channel · @m.CreatedAt.ToString("MMM d, yyyy")</small></li>
            }
            </ul>
        </div>
        @if (Model.Open is { } o)
        {
            <div class="byop-panel"><h2>@o.Template</h2><div class="msg-body">@Html.Raw(Model.Html)</div></div>
        }
    </div>
</div></section>
