@page "/myaccount/reset-password/{token}"
@model ResetModel
@inject Brand B
@{ ViewData["Title"] = $"Reset Password | {B.Name}"; }
<section class="section section-sky"><div class="wrap" style="max-width:560px">
    <div class="byop-panel">
        <h1 style="font-size:1.6rem">Choose a new password</h1>
        @if (Model.Problem is { } p) { <div class="form-msg error" role="alert">@p</div> <p><a href="/myaccount/forgot-password">Send a new link</a></p> }
        <form method="post" class="stack-form">
            <div class="field"><label for="pw">New password</label><input id="pw" name="password" type="password" autocomplete="new-password" minlength="8" required></div>
            <div class="field"><label for="cf">Type it again</label><input id="cf" name="confirm" type="password" autocomplete="new-password" required></div>
            <button class="btn">Save</button>
        </form>
    </div>
</div></section>
