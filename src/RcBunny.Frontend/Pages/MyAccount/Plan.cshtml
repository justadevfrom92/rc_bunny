@page "/myaccount/plan"
@model PlanPageModel
@inject Brand B
@{ ViewData["Title"] = $"My Plan | {B.Name}"; var c = Model.Customer; }
<section class="section section-sky"><div class="wrap">
    <partial name="_Frame" model="Model" />
    <partial name="_Flash" model="Model" />
    <div class="byop-panel">
        <h2>Your plan</h2>
        <p><strong>@(c.Plan?.Name ?? "—")</strong>@if (Model.Term is { } t) { <span> · @t.Status · @t.ContractStart?.ToString("MMM d, yyyy") – @t.ContractEnd?.ToString("MMM d, yyyy") · @t.Rate2000.ToString("0.0")¢/kWh</span> }</p>
    </div>
    <h2 style="margin:28px 0 12px">Renew</h2>
    <div class="ma-cards">
        @foreach (var (p, price) in Model.Options)
        {
            <div class="ma-card">
                <h3>@p.Name</h3>
                <strong class="big">@price?.ToString("0.0")¢</strong>
                <p>per kWh at 1,000 kWh · @Pricing.TermLabel(p.Term)</p>
                <form method="post"><input type="hidden" name="planId" value="@p.Id"><button class="btn">Renew on this plan</button></form>
            </div>
        }
        @if (Model.Options.Count == 0) { <p>Call <a href="@B.PhoneHref">@B.Phone</a> for renewal options.</p> }
    </div>
</div></section>
