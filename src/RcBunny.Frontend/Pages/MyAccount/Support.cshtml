@page "/myaccount/support/{id:int?}"
@model RcBunny.Frontend.Pages.MyAccount.SupportModel
@using RcBunny.Data
@{
    var t = Model.Ticket;
    ViewData["Title"] = t?.Number ?? "Support Tickets"; ViewData["MaTitle"] = t?.Subject ?? "Support Tickets";
    ViewData["Customer"] = Model.Customer; ViewData["Error"] = Model.Error;
    Layout = "_MyAccount";
    string StatusLabel(SupportTicket x) => x.Status switch { "waiting" => "Waiting on you", "new" => "Received", _ => char.ToUpper(x.Status[0]) + x.Status[1..] };
}
@if (t is null)
{
  <div class="co-card">
    <div class="sp-head"><p>Questions about your bill, your plan or your service? Open a ticket and our team will reply here.</p><a class="btn" href="/myaccount/support/new">New Ticket</a></div>
    <div class="ma-table"><table class="price-table msg-list">
      <thead><tr><th>Ticket</th><th>Subject</th><th>Status</th><th>Last Update</th><th><span class="sr-only">Open</span></th></tr></thead>
      <tbody>
        @foreach (var x in Model.Tickets)
        {
          <tr><td class="nowrap"><a href="/myaccount/support/@x.Id">@x.Number</a></td>
            <td><a class="msg-link" href="/myaccount/support/@x.Id"><b>@x.Subject</b></a><br><small>@Ranger.Topics.GetValueOrDefault(x.Topic)</small></td>
            <td><span class="sp-status sp-@x.Status">@StatusLabel(x)</span>@if (x.IsDone && x.Rating == null) { <br><small>Tell us how we did</small> }</td>
            <td class="nowrap"><small>@x.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</small></td>
            <td class="num"><a href="/myaccount/support/@x.Id" aria-label="Open @x.Number">Open ›</a></td></tr>
        }
        @if (Model.Tickets.Count == 0) { <tr><td colspan="5">No tickets yet.</td></tr> }
      </tbody>
    </table></div>
  </div>
}
else
{
  <div class="co-card">
    <p class="sp-meta"><b>@t.Number</b> · @Ranger.Topics.GetValueOrDefault(t.Topic) · opened @t.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ·
      <span class="sp-status sp-@t.Status">@StatusLabel(t)</span></p>

    @if (t.IsDone)
    {
      <div class="sp-rate">
        @if (t.Rating != null)
        {
          <p><b>Thanks for your feedback.</b> You said we @(t.Rating == "good" ? "helped 👍" : "didn't help 👎").@if (t.RatingComment != null) { <text> “@t.RatingComment”</text> }</p>
        }
        else
        {
          <form method="post" asp-page-handler="Rate" asp-route-id="@t.Id">
            <p><b>Did we help?</b></p>
            <div class="sp-topics"><label><input type="radio" name="rating" value="good" required><span>👍 Yes</span></label><label><input type="radio" name="rating" value="bad"><span>👎 No</span></label></div>
            <div class="field"><label for="sp-comment">Anything to add? (optional)</label><textarea id="sp-comment" name="comment" maxlength="1000" style="min-height:80px"></textarea></div>
            <button class="btn">Send Rating</button>
          </form>
        }
      </div>
    }

    <div class="sp-thread">
      @foreach (var m in Model.Thread)
      {
        var who = m.Kind == "customer" ? "You" : $"{m.Author.Split(' ')[0]} · {Site.Name}";
        if (m.Via == "phone")
        {
          <p class="sp-call">📞 @(m.Direction == "in" ? "You called us" : "We called you") · spoke with @m.Author.Split(' ')[0] · @((m.DurationSec ?? 0) / 60):@(((m.DurationSec ?? 0) % 60).ToString("00")) min <small>@m.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small></p>
        }
        else
        {
          <div class="sp-msg sp-@(m.Kind == "customer" ? "you" : "us")">
            <div class="sp-who"><b>@who</b> @if (m.Via == "email") { <small>✉ by email</small> } <small>@m.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small></div>
            <div style="white-space:pre-wrap">@m.Body</div>
            @{ var files = Model.Files.Where(f => f.MessageId == m.Id).ToList(); }
            @if (files.Count > 0)
            {
              <div class="sp-files">@foreach (var a in files) { <a href="/myaccount/support/@t.Id?handler=File&fileId=@a.Id">@(a.IsImage ? "🖼" : a.IsPdf ? "📄" : "📎") @a.Name <small>@(a.Size >= 1048576 ? $"{a.Size / 1048576.0:0.#} MB" : $"{Math.Max(1, a.Size / 1024)} KB")</small></a> }</div>
            }
          </div>
        }
      }
    </div>

    @if (t.Status != "closed")
    {
      <form method="post" asp-page-handler="Reply" asp-route-id="@t.Id" enctype="multipart/form-data">
        <div class="field"><label for="sp-reply">@(t.IsDone ? "Still need help? Reply and we'll reopen it" : "Reply")</label><textarea id="sp-reply" name="message" required maxlength="5000"></textarea></div>
        <div class="field"><label for="sp-files">Attach files (optional)</label><input id="sp-files" type="file" name="files" multiple accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.heic,.txt,.csv,.doc,.docx,.xls,.xlsx"></div>
        <div class="sp-actions"><a class="btn btn-outline btn-back" href="/myaccount/support">Back</a><button class="btn">Send</button></div>
      </form>
    }
    else
    {
      <p><small>This ticket is closed. <a href="/myaccount/support/new">Open a new ticket</a> if you need more help.</small></p>
    }
  </div>
}
