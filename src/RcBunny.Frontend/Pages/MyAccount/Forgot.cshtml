@page "/myaccount/forgot-{what}"
@model ForgotModel
@inject Brand B
@{ ViewData["Title"] = $"Forgot {Model.What} | {B.Name}"; }
<section class="section section-sky"><div class="wrap" style="max-width:560px">
    <div class="byop-panel">
        <h1 style="font-size:1.6rem">Forgot your @Model.What?</h1>
        @if (Model.Message is { } m)
        {
            <div class="form-msg ok" role="status">@m</div>
            @if (Model.DevLink is { } d) { <p class="dev-note">@(d.StartsWith('/') ? Html.Raw($"(Development) <a href=\"{d}\">reset link</a>") : d)</p> }
        }
        else
        {
            <form method="post" class="stack-form">
                <div class="field"><label for="e">Email on your account</label><input id="e" name="email" type="email" required></div>
                <button class="btn">Send</button>
            </form>
        }
        <p style="margin-top:16px"><a href="/myaccount/login">Back to sign in</a></p>
    </div>
</div></section>
