@model RcBunny.Frontend.Pages.MyAccount.MyAccountPage
@{
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/');
    string On(string href) => (href == "/myaccount" ? path == href : path.StartsWith(href)) ? "on" : "";
    var linked = Model.Customer.LinkedAccounts as System.Text.Json.Nodes.JsonArray;
}
<div class="ma-head">
    <div>
        <span class="eyebrow">My Account</span>
        <h1>Howdy, @(Model.Customer.FirstName ?? Model.Customer.Name)</h1>
        <p>Account <strong>@Model.Customer.Account</strong> · @Model.Customer.Address, @Model.Customer.City</p>
        @if (linked is { Count: > 0 })
        {
            <form method="post" action="/myaccount/profile?handler=Switch" asp-antiforgery="true" class="row-form">
                <label>Switch account <select name="account">@foreach (var a in linked) { <option>@a</option> }</select></label> <button class="btn btn-outline btn-sm">Go</button>
            </form>
        }
    </div>
    <form method="post" action="/myaccount/logout" asp-antiforgery="true"><button class="btn btn-outline" type="submit">Sign out</button></form>
</div>
<nav class="ma-nav" aria-label="My Account">
    <a class="@On("/myaccount")" href="/myaccount">Dashboard</a>
    <a class="@On("/myaccount/bills")" href="/myaccount/bills">Bills</a>
    <a class="@On("/myaccount/pay")" href="/myaccount/pay">Pay</a>
    <a class="@On("/myaccount/payment-methods")" href="/myaccount/payment-methods">Payment Methods</a>
    <a class="@On("/myaccount/insights")" href="/myaccount/insights">Usage</a>
    <a class="@On("/myaccount/plan")" href="/myaccount/plan">Plan</a>
    <a class="@On("/myaccount/products")" href="/myaccount/products">Products</a>
    <a class="@On("/myaccount/transfer")" href="/myaccount/transfer">Moving</a>
    <a class="@On("/myaccount/rewards")" href="/myaccount/rewards">Rewards</a>
    <a class="@On("/myaccount/refer")" href="/myaccount/refer">Refer</a>
    <a class="@On("/myaccount/orders")" href="/myaccount/orders">Orders</a>
    <a class="@On("/myaccount/messages")" href="/myaccount/messages">Messages</a>
    <a class="@On("/myaccount/support")" href="/myaccount/support">Support</a>
    <a class="@On("/myaccount/profile")" href="/myaccount/profile">Profile</a>
</nav>
<div data-island="ChatBubble"></div><script type="application/json" data-island-props>{}</script>
