@page "/myaccount/pay"
@model RcBunny.Frontend.Pages.MyAccount.PayModel
@{ ViewData["Title"] = $"Pay My Bill | {Site.Name}"; }
<section class="section section-sky">
    <div class="wrap" style="max-width:520px">
        <form class="byop-panel" method="post" autocomplete="off">
            <h1 style="font-size:1.6rem">Pay my bill</h1>
            <p>Your balance is <strong>@Model.Customer.Balance.ToString("C")</strong>.</p>
            @if (Model.Error is { } error) { <div class="form-msg error">@error</div> }
            <div class="field"><label for="a">Amount</label><input id="a" asp-for="Amount" type="number" step="0.01" min="0.01" required></div>
            <div class="field" style="margin-top:12px"><label for="n">Card number</label><input id="n" asp-for="CardNumber" inputmode="numeric" required></div>
            <button class="btn btn-block" style="margin-top:16px">Pay</button>
            <p><a href="/myaccount">← Back</a></p>
        </form>
    </div>
</section>
