@page "/myaccount/rewards"
@model RcBunny.Frontend.Pages.MyAccount.RewardsModel
@{ ViewData["Title"] = $"Rewards | My Account | {Site.Name}"; var c = Model.Customer; }
<section class="section section-sky">
    <div class="wrap">
        <p><a href="/myaccount">← My Account</a></p>
        <div class="ma-head"><div><span class="eyebrow">Rewards</span><h1>You have @c.Stars.ToString("N0") stars</h1><p>Earn stars every time you pay your bill.</p></div></div>
        @if (TempData["redeemed"] is string done) { <div class="form-msg ok">@done</div> }
        @if (Model.Error is { } error) { <div class="form-msg error">@error</div> }
        <div class="ma-cards">
            @foreach (var o in Model.Offers)
            {
                var already = o.Effect == "drawing" && Model.InDrawing;
                <div class="ma-card">
                    <h3>@o.Stars.ToString("N0") stars</h3>
                    <strong>@o.Name</strong>
                    <p>@o.Description</p>
                    <form method="post"><input type="hidden" name="offerId" value="@o.Id">
                        <button class="btn @(c.Stars < o.Stars || already ? "btn-outline" : "")" disabled="@(c.Stars < o.Stars || already)">@(already ? "You're entered" : c.Stars < o.Stars ? $"{o.Stars - c.Stars:N0} more stars" : "Redeem")</button>
                    </form>
                </div>
            }
        </div>
        <div class="byop-panel" style="margin-top:24px">
            <h2>History</h2>
            <table class="price-table">
                <thead><tr><th>Date</th><th>What</th><th>Stars</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.History)
                    {
                        <tr><td>@e.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td><td>@e.Reason@(e.Fulfillment == "pending" ? " (on its way)" : "")</td><td>@e.Stars.ToString("+#,0;-#,0")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
