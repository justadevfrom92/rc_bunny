@page "/myaccount/rewards"
@model RcBunny.Frontend.Pages.MyAccount.RewardsModel
@{
    var c = Model.Customer;
    ViewData["Title"] = "My Rewards"; ViewData["MaTitle"] = "My Rewards"; ViewData["Customer"] = c;
    ViewData["Status"] = TempData["redeemed"]; ViewData["Error"] = Model.Error;
    Layout = "_MyAccount";
}
<div class="co-card"><p>You have <b>@c.Stars.ToString("N0") stars</b>. Earn stars for on-time payments, paperless billing and referrals.</p></div>
<div class="offer-grid">
  @foreach (var o in Model.Offers)
  {
    var locked = o.Stars > c.Stars;
    var entered = o.Effect == "drawing" && Model.InDrawing;
    <form method="post" class="offer-card @(locked ? "locked" : null)">
      <input type="hidden" name="offerId" value="@o.Id">
      <strong>@(o.Stars > 0 ? $"{o.Stars:N0} ★" : "Free")</strong><b>@o.Name</b><small>@o.Description</small>
      <button class="btn btn-block" disabled="@(locked || entered)">@(entered ? "You're entered" : locked ? $"Need {o.Stars - c.Stars:N0} more" : "Redeem")</button>
    </form>
  }
</div>
<div class="co-card" style="margin-top:20px"><h3>Star History</h3><table class="price-table"><tbody>
  @foreach (var s in Model.History) { <tr><td>@s.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td><td>@s.Reason</td><td>@(s.Stars >= 0 ? "+" : "")@s.Stars</td></tr> }
  @if (Model.History.Count == 0) { <tr><td>No stars yet.</td></tr> }
</tbody></table></div>
