@page "/myaccount/rewards"
@model RewardsModel
@inject Brand B
@{ ViewData["Title"] = $"{B.Rewards} | {B.Name}"; }
<section class="section section-sky"><div class="wrap">
    <partial name="_Frame" model="Model" />
    <partial name="_Flash" model="Model" />
    <div class="ma-cards"><div class="ma-card"><h3>@B.Rewards</h3><strong class="big">@Model.Customer.Stars.ToString("N0")</strong><p>stars to spend</p></div></div>
    <h2 style="margin:28px 0 12px">Spend your stars</h2>
    <div class="ma-cards">
        @foreach (var o in Model.Offers)
        {
            <div class="ma-card">
                <h3>@o.Name</h3><p>@o.Description</p><strong>@o.Stars.ToString("N0") stars</strong>
                <form method="post"><input type="hidden" name="offerId" value="@o.Id"><button class="btn" disabled="@(Model.Customer.Stars < o.Stars)">Redeem</button></form>
            </div>
        }
    </div>
    <div class="byop-panel" style="margin-top:24px">
        <h2>History</h2>
        <table class="price-table"><thead><tr><th>Date</th><th>Stars</th><th>For</th></tr></thead><tbody>
        @foreach (var s in Model.History) { <tr><td>@s.CreatedAt.ToString("MMM d, yyyy")</td><td>@s.Stars.ToString("+#,0;-#,0")</td><td>@s.Reason</td></tr> }
        </tbody></table>
    </div>
</div></section>
