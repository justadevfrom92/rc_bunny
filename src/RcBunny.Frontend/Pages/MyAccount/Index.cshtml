@page "/myaccount"
@model RcBunny.Frontend.Pages.MyAccount.IndexModel
@{ ViewData["Title"] = $"My Account | {Site.Name}"; var c = Model.Customer; }
<section class="section section-sky">
    <div class="wrap">
        <div class="ma-head">
            <div>
                <span class="eyebrow">My Account</span>
                <h1>Howdy, @c.Name.Split(' ')[0]</h1>
                <p>Account <strong>@c.Account</strong> · @c.Address, @c.City</p>
            </div>
            <form method="post" asp-page="/MyAccount/Logout"><button class="btn btn-outline">Sign out</button></form>
        </div>
        @if (TempData["paid"] is string paid) { <div class="form-msg ok">@paid</div> }

        <div class="ma-cards">
            <div class="ma-card">
                <h3>Amount due</h3>
                <strong class="big">@c.Balance.ToString("C")</strong>
                <p>Due @(c.DueDate?.ToString("MMM d, yyyy") ?? "—")@(c.Autopay ? " · AutoPay is on" : "")</p>
                <a class="btn" href="/myaccount/pay">Pay My Bill</a>
            </div>
            <div class="ma-card"><h3>Need help?</h3><strong>Support</strong><p>Ask us anything and track the answer.</p><a class="btn btn-outline" href="/myaccount/support">Get Support</a></div>
            <div class="ma-card"><h3>Your plan</h3><strong>@(c.Plan?.Name ?? "—")</strong><p>@(c.Plan is { } plan ? Pricing.TermLabel(plan.TermMonths) : "")</p></div>
        </div>

        <div class="ma-grid" style="margin-top:24px">
            <div class="byop-panel">
                <h2>Bills</h2>
                <table class="price-table">
                    <thead><tr><th>Billed</th><th>kWh</th><th>Amount</th><th>Due</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Bills) { <tr><td>@b.BilledOn.ToString("MMM d, yyyy")</td><td>@b.Kwh.ToString("N0")</td><td>@b.Amount.ToString("C")</td><td>@b.DueOn.ToString("MMM d")</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="byop-panel">
                <h2>Payments</h2>
                <table class="price-table">
                    <thead><tr><th>Date</th><th>Method</th><th>Amount</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments) { <tr><td>@p.PaidOn.ToString("MMM d, yyyy")</td><td>@p.Method</td><td>@p.Amount.ToString("C")</td><td>@p.Status</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
