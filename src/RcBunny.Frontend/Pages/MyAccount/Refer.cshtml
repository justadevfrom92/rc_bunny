@page "/myaccount/refer"
@model ReferModel
@inject Brand B
@{ ViewData["Title"] = $"Refer a Friend | {B.Name}"; var link = $"{Request.Scheme}://{Request.Host}/plans?ref={Model.Customer.ReferralCode}"; }
<section class="section section-sky"><div class="wrap">
    <partial name="_Frame" model="Model" />
    <div class="byop-panel" style="max-width:640px">
        <h2>Refer a friend</h2>
        <p>Share your link. When a friend signs up, you both get rewarded.</p>
        <div class="field"><label for="rl">Your link</label><input id="rl" readonly value="@link" onfocus="this.select()"></div>
        <p>Your code: <strong>@Model.Customer.ReferralCode</strong> · Friends who joined: <strong>@Model.Referred</strong></p>
    </div>
</div></section>
