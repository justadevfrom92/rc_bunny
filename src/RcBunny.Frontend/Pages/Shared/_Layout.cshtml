@* The website layout for every page, same as ebunny's frontend/layouts/main.blade.php: style.css, and the header and
   footer filled in by main.js. Pages set ViewData["Title"] (or ["FullTitle"]), ["Description"], and ["NoHeading"]
   when they have their own h1, and ["DataPage"], ["DataPromo"], ["DataRep"], ["DataMarket"] for the body (Lando pages). *@
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["FullTitle"] ?? $"{ViewData["Title"]} | {Site.Name}")</title>
  @if (ViewData["Description"] is string description) { <meta name="description" content="@description"> }
  @await RenderSectionAsync("Head", required: false)
  <link rel="stylesheet" href="/frontend/css/style.css">
  <script src="/shared/boot.js" data-then="/frontend/js/main.js"></script>
  <script src="/shared/password-toggle.js" defer></script>
  <script src="/shared/datepicker.js" defer></script>
</head>
<body data-page="@ViewData["DataPage"]" data-promo="@ViewData["DataPromo"]" data-rep="@ViewData["DataRep"]" data-market="@ViewData["DataMarket"]">
  <div id="site-header"></div>
  @await RenderSectionAsync("Notice", required: false)

  <main>
    @if (ViewData["ShowTitle"] is true)
    {
      <div class="page-title"><div class="wrap">
        @if (ViewData["Eyebrow"] is string eyebrow) { <p class="eyebrow">@eyebrow</p> }
        <h1>@(ViewData["Heading"] ?? ViewData["Title"])</h1>
      </div></div>
    }
    else if (ViewData["NoHeading"] is not true)
    {
      <h1 class="sr-only">@(ViewData["Heading"] ?? ViewData["Title"])</h1>
    }
    @RenderBody()
  </main>

  <div id="site-footer"></div>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
