@model PlanPrice
<article class="plan">
    <div class="plan-top">
        <span class="plan-term">@Pricing.TermLabel(Model.Plan.TermMonths)</span>
        <h3>@Model.Plan.Name</h3>
        <div class="plan-rate"><strong>@Model.PriceAt1000.ToString("0.0")¢</strong><span>per kWh</span></div>
        <p class="plan-rate-note">Average price at 1,000 kWh</p>
    </div>
    <div class="plan-body">
        <ul class="checks">
            @if (Model.Plan.GreenPercent > 0) { <li>@Model.Plan.GreenPercent% renewable</li> }
            <li>@(Model.Plan.TermMonths <= 1 ? "No contract" : "Fixed rate for the whole term")</li>
        </ul>
        <a class="btn btn-block" href="/contact?plan=@Uri.EscapeDataString(Model.Plan.Name)">Sign Up</a>
    </div>
</article>
