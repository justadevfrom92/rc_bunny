@page
@model IndexModel
@{ ViewData["Title"] = $"{Site.Name} | Texas Electricity Plans"; }
<section class="hero">
    <div class="wrap">
        <div>
            <span class="eyebrow">Texas Electricity, Texas Proud</span>
            <h1>Power that's <em>bigger</em> than Texas.</h1>
            <p>Lock in a low fixed rate and earn rewards just for keepin' the lights on.</p>
            <a class="btn" href="/plans">Shop Plans</a>
        </div>
        <form class="zip-card" action="/plans" method="get">
            <h2>Find your plan</h2>
            <p>Enter your zip code to see rates at your address.</p>
            <div class="field">
                <label for="zip">Service Zip Code</label>
                <input id="zip" name="zip" inputmode="numeric" maxlength="5" pattern="\d{5}" placeholder="e.g. 77001" required>
            </div>
            <button class="btn btn-block">View Plans</button>
        </form>
    </div>
</section>

<section class="section section-sky">
    <div class="wrap">
        <div class="plans-head">
            <div><span class="eyebrow">Featured Plans</span><h2>Our most popular plans</h2></div>
            <a class="btn btn-outline" href="/plans">See All Plans</a>
        </div>
        <div class="plan-grid">
            @foreach (var plan in Model.Featured) { <partial name="_PlanCard" model="plan" /> }
        </div>
    </div>
</section>
