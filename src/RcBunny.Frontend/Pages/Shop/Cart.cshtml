@page "/shop/cart"
@model CartModel
@inject Brand B
@{ ViewData["Title"] = $"Cart | {B.Name}"; var sub = Model.Subtotal; var tax = Math.Round(sub * Cart.TaxRate, 2); var ship = Cart.Shipping(sub); }
<section class="section section-sky">
    <div class="wrap" style="max-width:900px">
        <h1>Your Cart</h1>
        @if (Model.Lines.Count == 0)
        {
            <div class="byop-panel"><p>Your cart is empty. <a href="/shop">Keep shopping</a>.</p></div>
        }
        else
        {
            <div class="byop-panel">
                <table class="price-table">
                    <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
                    <tbody>
                        @foreach (var (p, q) in Model.Lines)
                        {
                            <tr>
                                <td><a href="/shop/@ShopCatalog.Slug(p)">@p.Name</a><div class="muted">earns @((p.Stars * q).ToString("N0")) stars</div></td>
                                <td>@p.Price.ToString("C")</td>
                                <td><form method="post" action="/shop/cart?handler=Update" class="row-form"><input type="hidden" name="sku" value="@p.Sku"><select name="qty" onchange="this.form.submit()">@for (var i = 0; i <= 10; i++) { <option value="@i" selected="@(i == q)">@(i == 0 ? "Remove" : i)</option> }</select><noscript><button>Update</button></noscript></form></td>
                                <td>@((p.Price * q).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <dl class="cart-totals"><dt>Subtotal</dt><dd>@sub.ToString("C")</dd><dt>Tax</dt><dd>@tax.ToString("C")</dd><dt>Shipping</dt><dd>@(ship == 0 ? "Free" : ship.ToString("C"))</dd><dt><strong>Total</strong></dt><dd><strong>@((sub + tax + ship).ToString("C"))</strong></dd></dl>
                <a class="btn" href="/myaccount/checkout">Check Out</a> <a class="btn btn-outline" href="/shop">Keep Shopping</a>
                <p class="ma-note">Checking out signs you in to My Account; you can pay by card or put it on your electricity bill.</p>
            </div>
        }
    </div>
</section>
