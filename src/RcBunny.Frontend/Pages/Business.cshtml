@page "/business"
@model BusinessModel
@inject Brand B
@{
    ViewData["Title"] = $"Business Electricity Plans | {B.Name}";
}
<h1 class="sr-only">Takin' Care of Business</h1>
<section class="section section-sky">
    <div class="wrap">
        <div class="center">
            <span class="eyebrow">Business Plans</span>
            <h2>Plans built for Texas business</h2>
        </div>
        <div class="plan-grid" style="margin-top:40px">
            <article class="plan">
                <div class="plan-top">
                    <span class="plan-term">1 – 36 Months</span>
                    <h3>Takin' Care of Business</h3>
                    <p style="margin:0">Fixed or variable options for small and mid-size businesses, with terms from month-to-month up to three years.</p>
                </div>
                <div class="plan-body">
                    <ul class="checks"><li>12, 24 &amp; 36 month fixed terms</li><li>Month-to-month variable option</li><li>Dedicated business support</li></ul>
                    <a class="btn btn-block" href="/contact-us?topic=business">Get a Quote</a>
                </div>
            </article>
            <article class="plan featured">
                <span class="plan-flag">Builders</span>
                <div class="plan-top">
                    <span class="plan-term">12 or 24 Months</span>
                    <h3>Homebuilder</h3>
                    <p style="margin:0">Power for new construction, model homes and spec homes — with simple move-in hand-offs for your buyers.</p>
                </div>
                <div class="plan-body">
                    <ul class="checks"><li>Fast turn-on for new meters</li><li>Easy builder-to-buyer transfers</li><li>Consolidated multi-site billing</li></ul>
                    <a class="btn btn-block" href="/contact-us?topic=business">Get a Quote</a>
                </div>
            </article>
            <article class="plan">
                <div class="plan-top">
                    <span class="plan-term">12 Months</span>
                    <h3>Indexed 12</h3>
                    <p style="margin:0">Market-indexed pricing for businesses that want to ride wholesale rates with a transparent adder.</p>
                </div>
                <div class="plan-body">
                    <ul class="checks"><li>Transparent index-plus pricing</li><li>Monthly usage reporting</li><li>Ideal for larger accounts</li></ul>
                    <a class="btn btn-block" href="/contact-us?topic=business">Get a Quote</a>
                </div>
            </article>
        </div>
    </div>
</section>
<section class="cta-band">
    <div class="wrap">
        <h2>Let's power your business.</h2>
        <a class="btn" href="/contact-us?topic=business">Talk to Our Team</a>
    </div>
</section>
