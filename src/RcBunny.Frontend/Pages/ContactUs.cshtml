@page "/contact-us"
@model ContactUsModel
@inject Brand B
@{
    ViewData["Title"] = $"Contact Us | {B.Name}";
}
<h1 class="sr-only">Howdy! How can we help?</h1>
<section class="section">
    <div class="wrap contact-grid">
        <div>
            <div class="contact-card">
                <h3>Customer Care</h3>
                <p><a href="@B.PhoneHref">@B.Phone</a><br><span>@B.Hours</span></p>
            </div>
            <div class="contact-card">
                <h3>Power Outage?</h3>
                <p>Contact your local utility (TDSP) directly — they own the poles and wires and handle restoration.</p>
            </div>
            <div class="contact-card">
                <h3>Manage Your Account</h3>
                <p>Pay your bill, view usage and redeem @B.Rewards anytime in <a href="/myaccount">My Account</a>.</p>
            </div>
        </div>

        @* A normal form post (works without JavaScript); the ContactForm island sends it in the background instead. *@
        <island name="ContactForm" props="new { topics = ContactUsModel.Topics.Select(t => new { value = t.Value, label = t.Label }), Model.Form.Topic, Model.Form.Message }">
            <form class="byop-panel" method="post" action="/contact-us">
                <h2>Send us a message</h2>
                @if (Model.Sent)
                {
                    <div class="form-msg ok" role="status">Thanks! We got your message and will be in touch soon.</div>
                }
                @if (Model.Error is { } err)
                {
                    <div class="form-msg error" role="alert">@err</div>
                }
                <div class="form-2">
                    <div class="field"><label for="fn">First Name *</label><input id="fn" name="Form.First" value="@Model.Form.First" required maxlength="100"></div>
                    <div class="field"><label for="ln">Last Name *</label><input id="ln" name="Form.Last" value="@Model.Form.Last" required maxlength="100"></div>
                </div>
                <div class="form-2" style="margin-top:16px">
                    <div class="field"><label for="em">Email *</label><input id="em" name="Form.Email" type="email" value="@Model.Form.Email" required maxlength="200"></div>
                    <div class="field"><label for="ph">Phone</label><input id="ph" name="Form.Phone" type="tel" value="@Model.Form.Phone" maxlength="40"></div>
                </div>
                <div class="field" style="margin-top:16px">
                    <label for="topic">Topic</label>
                    <select id="topic" name="Form.Topic">
                        @foreach (var t in ContactUsModel.Topics)
                        {
                            <option value="@t.Value" selected="@(t.Value == Model.Form.Topic)">@t.Label</option>
                        }
                    </select>
                </div>
                <div class="field" style="margin-top:16px">
                    <label for="msg">Message *</label>
                    <textarea id="msg" name="Form.Message" required maxlength="5000">@Model.Form.Message</textarea>
                </div>
                <button class="btn" type="submit" style="margin-top:20px">Send Message</button>
            </form>
        </island>
    </div>
</section>
