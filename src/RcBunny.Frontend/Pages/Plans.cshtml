@page "/plans"
@model PlansModel
@{
    ViewData["Title"] = $"{(Model.Business ? "Business" : "Residential")} Electricity Plans | {Site.Name}";
    // The island gets the same plans as JSON and adds instant term filters on top.
    var props = new
    {
        plans = Model.Plans.Select(p => new { name = p.Plan.Name, term = p.Plan.TermMonths, price = p.PriceAt1000, green = p.Plan.GreenPercent }),
    };
}
<section class="section section-sky">
    <div class="wrap">
        <div class="plans-head">
            <div>
                <span class="eyebrow">@(Model.Business ? "Business" : "Residential") Plans</span>
                <h2 style="margin-bottom:0">Find your fit</h2>
                <p class="zip-note">@Model.Note</p>
            </div>
            <form method="get" class="row-form">
                @if (Model.Business) { <input type="hidden" name="type" value="business"> }
                <input name="zip" value="@Model.Zip" placeholder="Zip code" inputmode="numeric" maxlength="5" pattern="\d{5}">
                <button class="btn btn-outline">Update</button>
            </form>
        </div>

        @* Works without JavaScript. When the island loads it replaces this with the same cards plus filters. *@
        <div data-island="PlanFilter" data-props="@System.Text.Json.JsonSerializer.Serialize(props)">
            <div class="plan-grid">
                @foreach (var plan in Model.Plans) { <partial name="_PlanCard" model="plan" /> }
            </div>
        </div>
        <p style="font-size:.8rem;color:#96999d;margin-top:30px">Prices are the average per kWh at 1,000 kWh a month, including utility delivery charges and any monthly fee.</p>
    </div>
</section>
@section Scripts { <script type="module" src="~/js/islands.js" asp-append-version="true"></script> }
