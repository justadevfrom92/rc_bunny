<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RcBunny.Frontend</RootNamespace>
  </PropertyGroup>

  <!-- The database model lives in the Backend; the website compiles the same files so both always match. -->
  <ItemGroup>
    <Compile Include="../RcBunny.Backend/Data/*.cs" Link="Data/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Newer than the version SqlServer pulls in, which has a known vulnerability -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- The React islands live in ClientIslands. The first build installs and builds them into wwwroot/js. -->
  <ItemGroup>
    <Content Remove="ClientIslands/**" />
    <None Remove="ClientIslands/**" />
  </ItemGroup>
  <Target Name="BuildIslands" BeforeTargets="Build" Condition="!Exists('wwwroot/js/islands.js')">
    <Exec Command="npm install" WorkingDirectory="ClientIslands" />
    <Exec Command="npm run build" WorkingDirectory="ClientIslands" />
  </Target>

</Project>
