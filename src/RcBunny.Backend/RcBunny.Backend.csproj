<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RcBunny</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Newer than the version SqlServer pulls in, which has a known vulnerability -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Sample data the seeder reads on first start -->
  <ItemGroup>
    <None Include="Seed/data/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Seed/data/*.json" />
  </ItemGroup>

  <!-- The React admin lives in ClientApp. Every build rebuilds it into wwwroot when any of its files changed since the
       last time (so pulling new code and running dotnet run is enough), and installs packages when package-lock.json changed. -->
  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
    <ClientAppFiles Include="ClientApp/src/**;ClientApp/public/**;ClientApp/index.html;ClientApp/package.json;ClientApp/package-lock.json;ClientApp/vite.config.ts;ClientApp/tsconfig*.json" />
  </ItemGroup>
  <Target Name="InstallClientApp" BeforeTargets="BuildClientApp" Inputs="ClientApp/package-lock.json" Outputs="ClientApp/node_modules/.package-lock.json">
    <Exec Command="npm install" WorkingDirectory="ClientApp" />
  </Target>
  <Target Name="BuildClientApp" BeforeTargets="Build" Inputs="@(ClientAppFiles)" Outputs="wwwroot/index.html">
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

</Project>
