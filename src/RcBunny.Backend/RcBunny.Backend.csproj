<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RcBunny</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Newer than the version SqlServer pulls in, which has a known vulnerability -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Sample data the seeder reads on first start -->
  <ItemGroup>
    <None Include="Seed/data/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Seed/data/*.json" />
  </ItemGroup>

  <!-- The React admin lives in ClientApp. The first build installs and builds it into wwwroot. -->
  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
  </ItemGroup>
  <Target Name="BuildClientApp" BeforeTargets="Build" Condition="!Exists('wwwroot/index.html')">
    <Exec Command="npm install" WorkingDirectory="ClientApp" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

</Project>
